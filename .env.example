# Audiobook Manager Configuration
# Copy this file to .env and update the values for your setup

# Port for the web interface
PORT=8080

# --- Docker-specific variables (used in docker-compose files) ---

# Port to expose the web interface on the host (default: 3000)
APP_PORT=3000

# CORS origins - use * for open access, or comma-separated list
ALLOWED_ORIGINS=*
